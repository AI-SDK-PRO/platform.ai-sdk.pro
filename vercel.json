{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    },
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "functions": {
        "app/api/schedules/health/route.ts": {
          "experimentalTriggers": [
            {
              "type": "schedule/v1beta"
            }
          ]
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/(.*)",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "schedules": {
    "platform-health": {
      "schedule": "0 9 * * *",
      "timezone": "Asia/Bangkok",
      "service": "docs",
      "function": "app/api/schedules/health/route"
    }
  }
}
