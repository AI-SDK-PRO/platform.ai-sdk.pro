{
  "name": "@aisdkpro/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "rm -rf .next-dev && NODE_OPTIONS=--max-old-space-size=1536 NEXT_DEV_DIST_DIR=.next-dev next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "NODE_OPTIONS=--max-old-space-size=1536 next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=1024 tsc --noEmit",
    "agent:smoke": "tsx scripts/agent-smoke.ts",
    "platform:migrate": "tsx scripts/migrate-platform.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "3.0.143",
    "@ai-sdk/mcp": "1.0.102",
    "@ai-sdk/openai": "3.0.139",
    "@ai-sdk/openai-compatible": "2.0.92",
    "@ai-sdk/react": "3.0.329",
    "@aisdkpro/client": "*",
    "@aisdkpro/ui": "*",
    "@cloudflare/ai-chat": "0.12.2",
    "@google/genai": "^3.6.1",
    "@opennextjs/cloudflare": "^1.20.17",
    "@vercel/blob": "2.9.0",
    "agents": "0.33.0",
    "ai": "6.0.326",
    "drizzle-orm": "0.45.4",
    "flags": "4.4.0",
    "fumadocs-core": "16.18.4",
    "fumadocs-ui": "16.18.4",
    "geist": "1.4.2",
    "jose": "^6.2.17",
    "lucide-react": "^0.453.0",
    "next": "16.4.6",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "server-only": "^0.0.1",
    "streamdown": "^1.4.0",
    "zod": "^4.1.12",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.110.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "drizzle-kit": "0.31.11",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.0",
    "vitest": "^2.1.4",
    "wrangler": "^4.0.0"
  }
}
