{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aisdkpro-web-cloudflare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://aisdkpro-web-cloudflare.examplessdk.workers.dev",
    "APP_ORIGINS": "https://aisdkpro-web-cloudflare.examplessdk.workers.dev",
    "BYOK_ONLY": "true",
    "PLATFORM_DEPLOY_ORIGIN": "https://deploy-staging.ai-sdk.pro"
  }
}
