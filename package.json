{
  "name": "ai-sdk-pro",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/docs",
    "packages/ui",
    "packages/sdk"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:docs": "npm run dev --workspace=apps/docs",
    "build": "npm run build --workspace=packages/sdk && npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=packages/ui && npm run typecheck --workspace=packages/sdk && npm run typecheck --workspace=apps/web",
    "lint": "npm run typecheck --workspace=apps/web",
    "check": "npm run typecheck",
    "test": "vitest run",
    "start": "npm run start --workspace=apps/web",
    "agent:smoke": "npm run agent:smoke --workspace=apps/web"
  },
  "devDependencies": {
    "turbo": "^2.6.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0"
  }
}
