rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && data.updatedAt == request.time;
    }

    function isValidPromptPreset(data, userId, presetId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'prompt', 'providerPreference', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'prompt', 'providerPreference', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == presetId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000
        && data.providerPreference is string
        && data.providerPreference in ['edge-glm', 'openai', 'anthropic', 'google']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidWorkspaceNote(data, userId, noteId) {
      return data.keys().hasAll(['id', 'ownerId', 'body', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'repositorySlug', 'body', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == noteId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && (!('repositorySlug' in data) || (data.repositorySlug is string && data.repositorySlug.size() <= 140))
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /users/{userId}/private/{docId} {
      allow get: if isOwner(userId) && docId == 'account';
      allow list: if false;
      allow create: if isOwner(userId)
        && docId == 'account'
        && isValidUserAccount(incoming(), userId);
      allow update: if isOwner(userId)
        && docId == 'account'
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if isOwner(userId) && docId == 'account';
    }

    match /users/{userId}/presets/{presetId} {
      allow get: if isOwner(userId) && isValidId(presetId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(presetId)
        && isValidPromptPreset(incoming(), userId, presetId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(presetId)
        && isValidPromptPreset(incoming(), userId, presetId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'prompt', 'providerPreference', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(presetId);
    }

    match /users/{userId}/notes/{noteId} {
      allow get: if isOwner(userId) && isValidId(noteId);
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(noteId)
        && isValidWorkspaceNote(incoming(), userId, noteId)
        && incoming().createdAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(noteId)
        && isValidWorkspaceNote(incoming(), userId, noteId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['repositorySlug', 'body', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(noteId);
    }
  }
}
