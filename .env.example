# Copy to .env for local dev or VPS legacy deploy. On Vercel set these in Project → Environment Variables.
# Never commit .env or expose model/API keys in client code.

# --- Recommended hosting (no VPS): Vercel + Neon + Firebase — see infra/DEPLOY-VERCEL.md ---

# Public chat: visitors bring their own key; never fall back to owner credentials.
BYOK_ONLY=true

# Public site origins allowed for CORS on /api/chat (comma-separated HTTPS origins).
APP_ORIGINS=https://your-project.vercel.app

# Vercel / Cloudflare: per-IP rate limits on /api/chat (20/min/IP, 120/min global per instance).
# Local dev: leave unset or false.
TRUST_PROXY=true

# Workspace session signing + GitHub token encryption (required, >= 32 bytes).
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must match the public URL users open (no trailing path).
BETTER_AUTH_URL=https://your-project.vercel.app

# Neon Postgres — Workspace tables in schema aisdk_pro. Run: pnpm --filter @aisdkpro/web platform:migrate
NEON_DATABASE_URL=

# GitHub OAuth App (link repos after Firebase login) — NOT used for signing into the site.
# Callback: https://your-project.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=ai-sdk-pro

# Optional deploy bridge to Cloudflare platform worker (phase 2).
PLATFORM_DEPLOY_ORIGIN=https://your-project.vercel.app
PLATFORM_BRIDGE_SECRET=

# Build-time on Vercel: show email sign-up/sign-in on /login (Firebase Email/Password must be enabled).
NEXT_PUBLIC_FIREBASE_EMAIL_AUTH_ENABLED=true

# Optional Cloudflare Agent Worker for keyless demo chat (not BYOK).
NEXT_PUBLIC_CF_AGENT_URL=
AGENT_AUTH_SECRET=

# --- Optional private owner model (when BYOK_ONLY=false, dev only) ---
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
AI_API_KEY=
AI_BASE_URL=
MCP_SERVER_URL=
MCP_AUTH_TOKEN=

# --- Legacy VPS-only (Docker/Caddy) ---
DOMAIN=ai-sdk.pro
ACME_EMAIL=

# Optional GHCR image reference for GitHub Actions → Coolify (legacy).
# GHCR_IMAGE=ghcr.io/your-github-owner/ai-sdk-pro-web:commit-sha

# Optional feature flags (Flags SDK, local overrides).
FLAGS_SECRET=
DEPLOY_EXPERIMENTS_ENABLED=false
BLOB_UPLOADS_ENABLED=false

# Optional Vercel Blob private store (server-only token).
BLOB_READ_WRITE_TOKEN=

# Legacy Better Auth email via Resend — production sign-up uses Firebase Email instead.
# PLATFORM_EMAIL_AUTH_ENABLED=true
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=no-reply@mail.ai-sdk.pro

# Firebase client config is in firebase-applet-config.json (no separate NEXT_PUBLIC_ apiKey env).
# Do NOT add Firebase Admin SDK JSON to env unless you add server features that require it.