# ==============================================================================
# ai-sdk.pro Environment Variables Template (NEVER commit real secrets)
# ==============================================================================

# --- Core Platform Auth & Session (Required) ---
# PostgreSQL connection string from Neon (schema: aisdk_pro)
NEON_DATABASE_URL=
# Random secret >= 32 bytes (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public origin URL with protocol, no trailing path (e.g. https://platform.ai-sdk.pro)
BETTER_AUTH_URL=https://platform.ai-sdk.pro
# Comma-separated additional allowed HTTPS origins (optional)
APP_ORIGINS=https://platform.ai-sdk.pro,https://ai-sdk.pro,https://www.ai-sdk.pro
# Set to "true" behind Vercel / Cloudflare reverse proxies
TRUST_PROXY=true

# --- Firebase Authentication & App Check ---
# reCAPTCHA Enterprise site key from Firebase Console -> App Check
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set to "false" only if disabling Firebase Email/Password sign-up
NEXT_PUBLIC_FIREBASE_EMAIL_AUTH_ENABLED=true
# Optional: server-side Firebase Web API key
FIREBASE_API_KEY=

# --- GitHub OAuth (Repository Import & Deploy — separate from Firebase GitHub Login) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App slug only (e.g. platform-sdk-pro), NOT the full URL
GITHUB_APP_SLUG=platform-sdk-pro
GITHUB_DEPLOY_WEBHOOK_SECRET=

# --- AI Playground (Server-Side Gemini API Default + Optional BYOK) ---
# Gemini API key for server-side default (gemini-4-hydrogen)
GEMINI_API_KEY=
# Set to "false" (or leave unset when GEMINI_API_KEY is set) to allow Server Gemini default
BYOK_ONLY=false

# --- Optional Legacy / Multi-Provider / Edge / Deploy Bridge ---
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_CF_AGENT_URL=
AGENT_AUTH_SECRET=
PLATFORM_BRIDGE_SECRET=
PLATFORM_DEPLOY_ORIGIN=https://deploy-staging.ai-sdk.pro
DEPLOY_EXPERIMENTS_ENABLED=
FLAGS_SECRET=

# --- Optional Transactional Mail / Blob / Dev ---
PLATFORM_EMAIL_AUTH_ENABLED=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BLOB_READ_WRITE_TOKEN=
BLOB_UPLOADS_ENABLED=
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
ACME_EMAIL=
APP_ORIGIN=
DOMAIN=
NEXT_DEV_DIST_DIR=