# ==============================================================================
# ai-sdk.pro Environment Variables Template (NEVER commit real secrets)
# ==============================================================================

# --- Better Auth + Neon PostgreSQL ---
NEON_DATABASE_URL=
# Local development: http://localhost:3000. Production: https://ai-sdk.pro

# Existing server-only secret for platform GitHub connections. Preserve it when migrating.
BETTER_AUTH_SECRET=
# Public application origin for Better Auth.
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production callback registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://www.ai-sdk.pro/auth/platform
APP_ORIGINS=http://localhost:3000,https://ai-sdk.pro,https://www.ai-sdk.pro
TRUST_PROXY=true
# Google is the platform sign-in provider. GitHub OAuth below is only for repository access.

# --- GitHub OAuth (Repository Import & Deploy — separate from Google platform login) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App slug only (e.g. platform-sdk-pro), NOT the full URL
GITHUB_APP_SLUG=platform-sdk-pro
GITHUB_DEPLOY_WEBHOOK_SECRET=

# --- AI Playground (Server-Side Gemini API Default + Optional BYOK) ---
# Gemini API key for server-side default (gemini-4-hydrogen)
GEMINI_API_KEY=
# Set to "false" (or leave unset when GEMINI_API_KEY is set) to allow Server Gemini default
BYOK_ONLY=false

# --- Optional Legacy / Multi-Provider / Edge / Deploy Bridge ---
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_CF_AGENT_URL=
AGENT_AUTH_SECRET=
PLATFORM_BRIDGE_SECRET=
PLATFORM_DEPLOY_ORIGIN=https://deploy-staging.ai-sdk.pro
DEPLOY_EXPERIMENTS_ENABLED=
FLAGS_SECRET=

# --- VPS Caddy TLS & Domains (Required when running infra/production/docker-compose.yml) ---
DOMAIN=ai-sdk.pro
PLATFORM_DOMAIN=platform.ai-sdk.pro
ACME_EMAIL=

# --- Optional Blob / Dev ---

BLOB_READ_WRITE_TOKEN=
BLOB_UPLOADS_ENABLED=
MCP_SERVER_URL=
MCP_AUTH_TOKEN=
APP_ORIGIN=
NEXT_DEV_DIST_DIR=

# --- Google Maps Platform ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=