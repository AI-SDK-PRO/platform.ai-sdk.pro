APP_ORIGINS=https://ai-sdk.pro,https://www.ai-sdk.pro,https://platform.ai-sdk.pro
TRUST_PROXY=true
GITHUB_CLIENT_ID=
GITHUB_APP_SLUG=
BYOK_ONLY=true
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
NEXT_PUBLIC_CF_AGENT_URL=
PLATFORM_DEPLOY_ORIGIN=
DEPLOY_EXPERIMENTS_ENABLED=
PLATFORM_EMAIL_AUTH_ENABLED=true
RESEND_FROM_EMAIL=
BLOB_UPLOADS_ENABLED=false
MCP_SERVER_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
